# Xengsort classifies host=mouse and graft=human before species-specific alignment.

MODEL_MODE=cross_species
HOST_LABEL=mouse
GRAFT_LABEL=human

THREADS=8
XENGSORT_INDEX=/path/to/shared/rnaseq_refs/human_mouse/GRCh38_GRCm39/xengsort/human_mouse
XENGSORT_MODE=count
FASTQ_DIR=/path/to/project/fastq_qc_or_trimmed
OUTDIR=/path/to/project/results/species_split

R1_SUFFIX=_R1.fastq.gz
R2_SUFFIX=_R2.fastq.gz
RUN_FASTQC=yes
RUN_MULTIQC=yes
ALLOW_OVERWRITE=no
