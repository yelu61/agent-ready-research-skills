# Copy this trusted shell configuration into an analysis project and replace
# every placeholder. REFERENCE_DIR points to a versioned, read-only shared bundle.

MODEL_MODE=single_species
REFERENCE_ID=GRCh38
ANNOTATION_ID=GENCODE_v49

THREADS=16
REFERENCE_DIR=/path/to/shared/rnaseq_refs/human/GRCh38_GENCODE_v49
INDEX_BASENAME=genome_hisat2_index
FASTQ_DIR=/path/to/project/fastq
OUTDIR=/path/to/project/results/upstream

R1_SUFFIX=_R1.fastq.gz
R2_SUFFIX=_R2.fastq.gz

# Set a reviewed none/0, FR/1, or RF/2 pair; unknown blocks preflight.
HISAT2_STRANDNESS=unknown
FEATURECOUNTS_STRAND=unknown
STRANDEDNESS_SOURCE=unknown  # rseqc | library_protocol
STRANDEDNESS_EVIDENCE=/path/to/reviewed_strandedness_evidence.txt

DO_TRIM=no
TRIMMOMATIC_ADAPTERS=
RUN_FASTQC=yes
RUN_MULTIQC=yes
ALLOW_OVERWRITE=no
