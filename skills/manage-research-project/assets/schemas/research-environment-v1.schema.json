{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-environment-v1.schema.json",
  "title": "Typed computational environment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_id",
    "captured_at",
    "capture_method",
    "working_directory",
    "platform",
    "runtimes",
    "package_locks",
    "containers",
    "external_resources",
    "randomness"
  ],
  "properties": {
    "schema_version": {"const": "research-environment/v1"},
    "environment_id": {"$ref": "#/$defs/concreteString"},
    "captured_at": {"type": "string", "format": "date-time"},
    "capture_method": {"$ref": "#/$defs/concreteString"},
    "working_directory": {"$ref": "#/$defs/concreteString"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "release", "architecture"],
      "properties": {
        "os": {"$ref": "#/$defs/concreteString"},
        "release": {"$ref": "#/$defs/concreteString"},
        "architecture": {"$ref": "#/$defs/concreteString"}
      }
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {"$ref": "#/$defs/concreteString"},
          "version": {"$ref": "#/$defs/concreteString"}
        }
      }
    },
    "package_locks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "format"],
        "properties": {
          "path": {"$ref": "#/$defs/concreteString"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "format": {"$ref": "#/$defs/concreteString"}
        }
      }
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image", "digest"],
        "properties": {
          "image": {"$ref": "#/$defs/concreteString"},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "external_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "reference"],
        "properties": {
          "name": {"$ref": "#/$defs/concreteString"},
          "version": {"$ref": "#/$defs/concreteString"},
          "reference": {"$ref": "#/$defs/concreteString"}
        }
      }
    },
    "randomness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_policy", "seeds", "deterministic_operations", "parallelism"],
      "properties": {
        "seed_policy": {"$ref": "#/$defs/concreteString"},
        "seeds": {"type": "object"},
        "deterministic_operations": {"$ref": "#/$defs/concreteString"},
        "parallelism": {"$ref": "#/$defs/concreteString"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "concreteString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s*(?:(?:[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd])(?:\\b|:)|(?:[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Nn]/?[Aa]|[Nn][Oo][Nn][Ee])\\s*$))(?=[\\s\\S]*\\S)[\\s\\S]+$"
    }
  }
}
