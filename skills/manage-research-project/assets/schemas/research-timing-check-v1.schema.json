{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-timing-check-v1.schema.json",
  "title": "Prospective collection timing check",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "check_id", "created_at", "protocol_locked_at", "collection_started_at", "source_ids", "evidence_reference"],
  "properties": {
    "schema_version": {"const": "research-timing-check/v1"},
    "check_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "protocol_locked_at": {"type": "string", "format": "date-time"},
    "collection_started_at": {"type": "string", "format": "date-time"},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9A-F]{16}$"}},
    "evidence_reference": {"type": "string", "minLength": 1}
  }
}
