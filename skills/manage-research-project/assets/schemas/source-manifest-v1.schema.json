{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-manifest-v1.schema.json",
  "title": "Research source integrity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "scope_root",
    "scope_include",
    "scope_exclude",
    "hash_algorithm",
    "source_context",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": "source-manifest/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "scope_root": {"const": "."},
    "scope_include": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "scope_exclude": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "hash_algorithm": {"const": "sha256"},
    "source_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_system",
        "source_reference",
        "acquired_at",
        "data_freeze_id",
        "access_level",
        "subject_id_level",
        "license_or_agreement",
        "immutable_expected"
      ],
      "properties": {
        "source_system": {
          "oneOf": [
            {"$ref": "#/$defs/concreteString"},
            {"type": "null"}
          ]
        },
        "source_reference": {
          "oneOf": [
            {"$ref": "#/$defs/concreteString"},
            {"type": "null"}
          ]
        },
        "acquired_at": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "data_freeze_id": {
          "oneOf": [
            {"$ref": "#/$defs/concreteString"},
            {"type": "null"}
          ]
        },
        "access_level": {
          "enum": ["public", "internal", "restricted", "controlled", "unknown"]
        },
        "subject_id_level": {
          "enum": ["none", "deidentified", "coded", "identifiable", "unknown"]
        },
        "license_or_agreement": {
          "oneOf": [
            {"$ref": "#/$defs/concreteString"},
            {"type": "null"}
          ]
        },
        "immutable_expected": {"type": "boolean"}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "path", "type", "size_bytes", "hash_status"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^SRC-[0-9A-F]{16}$"},
          "path": {"type": "string", "minLength": 1},
          "type": {"const": "file"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "hash_status": {"enum": ["recorded", "not_permitted"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "access_reference": {"$ref": "#/$defs/concreteString"}
        },
        "allOf": [
          {
            "if": {"properties": {"hash_status": {"const": "recorded"}}},
            "then": {"required": ["sha256"]}
          },
          {
            "if": {"properties": {"hash_status": {"const": "not_permitted"}}},
            "then": {"required": ["access_reference"]}
          }
        ]
      }
    }
  },
  "$defs": {
    "concreteString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s*(?:(?:[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd])(?:\\b|:)|(?:[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Nn]/?[Aa]|[Nn][Oo][Nn][Ee])\\s*$))(?=[\\s\\S]*\\S)[\\s\\S]+$"
    }
  }
}
