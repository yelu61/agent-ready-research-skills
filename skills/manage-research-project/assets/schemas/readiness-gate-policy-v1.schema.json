{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "readiness-gate-policy-v1.schema.json",
  "title": "Versioned scientific-readiness gate policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "assessor",
    "domain",
    "applicable_study_types",
    "applicable_data_requirements",
    "methodological_basis",
    "authorizations",
    "gates"
  ],
  "properties": {
    "schema_version": {"const": "readiness-gate-policy/v1"},
    "policy_id": {"$ref": "#/$defs/concreteString"},
    "version": {"$ref": "#/$defs/concreteString"},
    "domain": {"$ref": "#/$defs/concreteString"},
    "applicable_study_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/concreteString"}
    },
    "applicable_data_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["none", "data_bearing"]}
    },
    "methodological_basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/concreteString"}
    },
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"$ref": "#/$defs/concreteString"},
        "version": {"$ref": "#/$defs/concreteString"}
      }
    },
    "authorizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["analysis_mode", "claim_classes", "validation_levels"],
        "properties": {
          "analysis_mode": {
            "enum": ["descriptive", "exploratory", "confirmatory", "predictive", "causal"]
          },
          "claim_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "observation",
                "association",
                "prediction",
                "causal_effect",
                "mechanism",
                "translational",
                "clinical_utility"
              ]
            }
          },
          "validation_levels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "none",
                "sensitivity",
                "orthogonal_same_material",
                "independent_external",
                "prospective"
              ]
            }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "required_for_ready",
          "allow_na",
          "requirement",
          "applicability",
          "evaluation_method",
          "pass_condition",
          "required_evidence_kinds",
          "failure_effect"
        ],
        "properties": {
          "gate_id": {"$ref": "#/$defs/concreteString"},
          "required_for_ready": {"type": "boolean"},
          "allow_na": {"type": "boolean"},
          "requirement": {"$ref": "#/$defs/concreteString"},
          "applicability": {"$ref": "#/$defs/concreteString"},
          "evaluation_method": {"$ref": "#/$defs/concreteString"},
          "pass_condition": {"$ref": "#/$defs/concreteString"},
          "required_evidence_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["file", "artifact", "run", "decision", "external"]
            }
          },
          "failure_effect": {"enum": ["block", "review"]}
        },
        "allOf": [
          {
            "if": {"properties": {"required_for_ready": {"const": true}}},
            "then": {"properties": {"failure_effect": {"const": "block"}}},
            "else": {"properties": {"failure_effect": {"const": "review"}}}
          }
        ]
      }
    }
  },
  "$defs": {
    "concreteString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s*(?:(?:[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd])(?:\\b|:)|(?:[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Nn]/?[Aa]|[Nn][Oo][Nn][Ee])\\s*$))(?=[\\s\\S]*\\S)[\\s\\S]+$"
    }
  }
}
