{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-readiness-v2.schema.json",
  "title": "Purpose-specific scientific readiness assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "readiness_id",
    "analysis_id",
    "scope_id",
    "readiness_purpose",
    "intended_use",
    "claim",
    "source_roles",
    "policy_authorization_id",
    "assessor",
    "assessed_at",
    "source_provenance_status",
    "readiness_status",
    "claim_authorization",
    "lifecycle_status",
    "gate_policy",
    "analysis_spec",
    "input_manifests",
    "input_source_ids",
    "code_manifest",
    "environment_manifest",
    "code_revision",
    "code_dirty",
    "backend_revision",
    "claim_support_gate_id",
    "curation_artifact_ids",
    "achieved_validations",
    "claim_boundary_notes",
    "gates"
  ],
  "properties": {
    "schema_version": {"const": "research-readiness/v2"},
    "readiness_id": {"$ref": "#/$defs/concreteString"},
    "analysis_id": {"$ref": "#/$defs/concreteString"},
    "scope_id": {"$ref": "#/$defs/concreteString"},
    "readiness_purpose": {"$ref": "#/$defs/readinessPurpose"},
    "intended_use": {"$ref": "#/$defs/concreteString"},
    "claim": {"$ref": "#/$defs/claim"},
    "source_roles": {"$ref": "#/$defs/sourceRoles"},
    "policy_authorization_id": {"type": "string", "pattern": "^AUTH-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"$ref": "#/$defs/concreteString"},
        "version": {"$ref": "#/$defs/concreteString"}
      }
    },
    "assessed_at": {"type": "string", "format": "date-time"},
    "source_provenance_status": {"enum": ["verified", "unverified", "conflicting", "not_applicable"]},
    "readiness_status": {"enum": ["ready", "review", "blocked"]},
    "claim_authorization": {"enum": ["authorized", "not_authorized"]},
    "lifecycle_status": {"enum": ["current", "superseded", "invalidated", "archived"]},
    "gate_policy": {"$ref": "#/$defs/fileBinding"},
    "analysis_spec": {"$ref": "#/$defs/fileBinding"},
    "input_manifests": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fileBinding"}
    },
    "input_source_ids": {"$ref": "#/$defs/sourceIds"},
    "code_manifest": {"$ref": "#/$defs/fileBinding"},
    "environment_manifest": {"$ref": "#/$defs/fileBinding"},
    "code_revision": {"$ref": "#/$defs/concreteString"},
    "code_dirty": {"type": "boolean"},
    "backend_revision": {"oneOf": [{"$ref": "#/$defs/concreteString"}, {"type": "null"}]},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/fileBinding"}},
    "claim_support_gate_id": {"type": ["string", "null"]},
    "curation_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ART-[A-Za-z0-9][A-Za-z0-9._-]*$"}
    },
    "achieved_validations": {
      "type": "array",
      "items": {"$ref": "#/$defs/achievedValidation"}
    },
    "claim_boundary_notes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/concreteString"}
    },
    "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}}
  },
  "$defs": {
    "concreteString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s*(?:(?:[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd])(?:\\b|:)|(?:[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Nn]/?[Aa]|[Nn][Oo][Nn][Ee])\\s*$))(?=[\\s\\S]*\\S)[\\s\\S]+$"
    },
    "readinessPurpose": {
      "enum": ["analysis_execution", "result_interpretation", "claim_communication", "decision_support"]
    },
    "claimClass": {
      "enum": ["observation", "association", "prediction", "causal_effect", "mechanism", "translational", "clinical_utility"]
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/concreteString"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sourceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^SRC-[0-9A-F]{16}$"}
    },
    "artifactIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ART-[A-Za-z0-9][A-Za-z0-9._-]*$"}
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "statement", "claim_class", "source_ids", "estimand", "population", "contrast", "outcome", "time_frame"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^CLM-[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "statement": {"$ref": "#/$defs/concreteString"},
        "claim_class": {"$ref": "#/$defs/claimClass"},
        "source_ids": {"$ref": "#/$defs/sourceIds"},
        "estimand": {"$ref": "#/$defs/concreteString"},
        "population": {"$ref": "#/$defs/concreteString"},
        "contrast": {"$ref": "#/$defs/concreteString"},
        "outcome": {"$ref": "#/$defs/concreteString"},
        "time_frame": {"$ref": "#/$defs/concreteString"}
      }
    },
    "sourceRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_source_ids", "independent_validation_source_ids"],
      "properties": {
        "primary_source_ids": {"$ref": "#/$defs/sourceIds"},
        "independent_validation_source_ids": {"$ref": "#/$defs/sourceIds"}
      }
    },
    "gateCategory": {
      "enum": ["data_provenance", "design_and_sampling", "unit_and_replication", "measurement_quality", "missingness_and_censoring", "multiplicity_and_selection", "robustness_and_sensitivity", "computational_reproducibility", "result_integrity", "claim_evidence", "validation", "data_leakage", "model_lock_and_evaluation", "calibration", "external_validity", "causal_identification", "temporality", "confounding_and_exchangeability", "positivity_and_overlap", "causal_sensitivity", "perturbation_and_intervention", "alternative_explanations", "necessity_sufficiency_rescue", "transportability", "clinical_relevance", "decision_comparator", "clinical_utility", "prospective_evaluation", "safety_and_harms"]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "gate_category", "required_for_ready", "status", "requirement", "evidence", "impact", "remediation"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/concreteString"},
        "gate_category": {"$ref": "#/$defs/gateCategory"},
        "required_for_ready": {"type": "boolean"},
        "status": {"enum": ["PASS", "FAIL", "UNKNOWN", "NA"]},
        "requirement": {"$ref": "#/$defs/concreteString"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
        "impact": {"type": "string"},
        "remediation": {"type": "string"}
      }
    },
    "evidenceRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "sha256"],
          "properties": {
            "kind": {"const": "file"},
            "ref": {"$ref": "#/$defs/concreteString"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "path", "sha256", "record_sha256"],
          "properties": {
            "kind": {"const": "artifact"},
            "ref": {"type": "string", "pattern": "^ART-[A-Za-z0-9][A-Za-z0-9._-]*$"},
            "path": {"$ref": "#/$defs/concreteString"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "record_sha256", "log_sha256", "artifact_record_sha256s", "lineage_record_sha256s"],
          "properties": {
            "kind": {"const": "run"},
            "ref": {"type": "string", "pattern": "^RUN-[A-Za-z0-9][A-Za-z0-9._-]*$"},
            "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "artifact_record_sha256s": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {"pattern": "^ART-[A-Za-z0-9][A-Za-z0-9._-]*$"},
              "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "lineage_record_sha256s": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {"pattern": "^ART-[A-Za-z0-9][A-Za-z0-9._-]*$"},
              "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "record_sha256"],
          "properties": {
            "kind": {"const": "decision"},
            "ref": {"type": "string", "pattern": "^D-[0-9]{8}-[0-9]{2,}$"},
            "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref"],
          "properties": {
            "kind": {"const": "external"},
            "ref": {"$ref": "#/$defs/concreteString"}
          }
        }
      ]
    },
    "validationDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_relation", "collection_timing", "measurement_relation", "analysis_relation", "evaluation_blinding"],
      "properties": {
        "data_relation": {"enum": ["same_observations", "held_out_observations", "same_subjects_new_measurement", "independent_sampling_frame", "not_assessed", "not_applicable"]},
        "collection_timing": {"enum": ["existing_before_claim_lock", "collected_after_claim_lock", "not_assessed", "not_applicable"]},
        "measurement_relation": {"enum": ["same_measurement_process", "orthogonal_measurement_process", "not_assessed", "not_applicable"]},
        "analysis_relation": {"enum": ["same_implementation", "alternative_method_same_team", "independent_implementation", "not_assessed", "not_applicable"]},
        "evaluation_blinding": {"enum": ["unblinded", "blinded_to_outcome_or_label", "not_assessed", "not_applicable"]}
      }
    },
    "achievedValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_id", "planned_validation_id", "dimensions", "input_source_ids", "evaluation_source_ids", "evaluation_input_artifact_ids", "partition_binding", "partition_unit", "unit_overlap_check", "timing_check", "success_criterion", "outcome", "observed_result", "evidence_gate_ids"],
      "properties": {
        "validation_id": {"type": "string", "pattern": "^AV-[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "planned_validation_id": {"oneOf": [{"type": "string", "pattern": "^PV-[A-Za-z0-9][A-Za-z0-9._-]*$"}, {"type": "null"}]},
        "dimensions": {"$ref": "#/$defs/validationDimensions"},
        "input_source_ids": {"$ref": "#/$defs/sourceIds"},
        "evaluation_source_ids": {"$ref": "#/$defs/sourceIds"},
        "evaluation_input_artifact_ids": {"$ref": "#/$defs/artifactIds"},
        "partition_binding": {"oneOf": [{"$ref": "#/$defs/fileBinding"}, {"type": "null"}]},
        "partition_unit": {"type": ["string", "null"]},
        "unit_overlap_check": {"oneOf": [{"$ref": "#/$defs/fileBinding"}, {"type": "null"}]},
        "timing_check": {"oneOf": [{"$ref": "#/$defs/fileBinding"}, {"type": "null"}]},
        "success_criterion": {"$ref": "#/$defs/concreteString"},
        "outcome": {"enum": ["passed", "failed", "inconclusive"]},
        "observed_result": {"$ref": "#/$defs/concreteString"},
        "evidence_gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/concreteString"}
        }
      }
    }
  }
}
